# ---- General ------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# ---- Security -------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_PER_MINUTE=60

# ---- Database -------------------------------------------------------------
# Local dev / docker-compose default:
DATABASE_URL=postgresql+asyncpg://beta:beta_password@db:5432/beta_db
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Firebase ---------------------------------------------------------------
# Path to the Firebase service-account JSON file (mount it into the container).
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_PROJECT_ID=beta-ai-bbc28

# ---- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Speech (STT/TTS) - uses the same OPENAI_API_KEY above --------------------
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_DEFAULT_VOICE=alloy
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_SECONDS=30

# ---- Memory ---------------------------------------------------------------
VECTOR_DIMENSIONS=1536
MEMORY_TOP_K=5
SHORT_TERM_MEMORY_TURNS=10

# ---- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
