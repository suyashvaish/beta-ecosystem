# ---- Core ----
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://beta:beta@localhost:5432/beta
ENVIRONMENT=local
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- Firebase ----
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_PROJECT_ID=beta-ai-bbc28

# ---- AI provider (Beta Intelligence) ----
# Option 1: keep OpenAI (existing behaviour)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Option 2: self-hosted open-weight model (recommended for 2.0):
#   1) Install Ollama and run:  ollama pull qwen2.5:7b-instruct
#                              ollama pull nomic-embed-text
#   2) Set AI_PROVIDER=local and LOCAL_AI_BASE_URL=http://localhost:11434/v1
#   Production: vLLM or llama.cpp server with the same OpenAI-compatible
#   endpoint shape. No OpenAI dependency at all in this mode.
# AI_PROVIDER=local
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_API_KEY=
LOCAL_CHAT_MODEL=qwen2.5:7b-instruct
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# ---- Search providers (Beta Intelligence) ----
# Optional; missing keys simply disable the corresponding tool and
# Beta says so honestly.
# Google Maps Platform key with Places API enabled:
GOOGLE_MAPS_API_KEY=
# SerpApi key (https://serpapi.com) for web search:
SERPAPI_KEY=

# ---- Memory ----
VECTOR_DIMENSIONS=1536
EMBEDDING_DIMENSIONS=1536
MEMORY_TOP_K=5
SHORT_TERM_MEMORY_TURNS=10

# ---- Speech ----
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_DEFAULT_VOICE=alloy

# ---- Notifications ----
FCM_CREDENTIALS_PATH=firebase-credentials.json

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true